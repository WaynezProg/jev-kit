#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for p in python3.14 python3.13 python3.12 python3.11 python3; do command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null && exec "$p" "$root/scripts/manage.py" "$@"; done
echo 'Jev Kit: Python 3.11+ required' >&2
exit 1
